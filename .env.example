NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://fixtech_demo:replace-me@localhost:5432/fixtech_demo_v18
DB_POOL_MAX=5
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Set a unique local-only password before running npm run seed.
DEMO_SEED_PASSWORD=replace-with-a-unique-demo-password
# Demo-only: app startup rejects Ollama when NODE_ENV=production.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
AI_TIMEOUT_MS=120000
MARKET_PRICE_PROVIDER=curated_demo
# Live-source freshness only; curated references use reviewedAt + 30 days.
MARKET_PRICE_MAX_AGE_HOURS=24
